{
  "name": "pi-extensions-oss",
  "version": "0.2.44",
  "description": "Productivity and resilience extensions for Pi: pluck context import, session notes scratchpad, aside side-question overlay, browser screenshot tool, screenshot picker, project context loading, LM Studio integration, calm tool display, compact update status, working prompt snippet, branch-aware todos, and OSS version status",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "productivity",
    "terminal-ui",
    "session-notes",
    "pluck",
    "aside",
    "notes",
    "screenshot",
    "todo",
    "todos",
    "tui",
    "developer-tools",
    "screenshot-picker",
    "playwright",
    "browser-automation",
    "working-message",
    "project-context",
    "lmstudio",
    "calm-tools"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thegalexc/pi-extensions-oss.git"
  },
  "homepage": "https://github.com/thegalexc/pi-extensions-oss",
  "bugs": {
    "url": "https://github.com/thegalexc/pi-extensions-oss/issues"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "public"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=1 extensions/agents-prompts-discover/index.test.ts extensions/aside/aside.test.ts extensions/compact-update-notice/index.test.ts extensions/library-manifest/index.test.ts extensions/library-manifest/entrypoint.test.ts extensions/pluck/pluck.test.ts"
  },
  "overrides": {
    "basic-ftp": "5.3.0"
  },
  "dependencies": {
    "@lmstudio/sdk": "^1.5.0",
    "glob": "^11.0.0",
    "playwright": "^1.58.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.79.1",
    "@earendil-works/pi-ai": "^0.79.1",
    "@earendil-works/pi-coding-agent": "^0.79.1",
    "@earendil-works/pi-tui": "^0.79.1",
    "@sinclair/typebox": "^0.34.48",
    "@types/node": "^24.5.2",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
