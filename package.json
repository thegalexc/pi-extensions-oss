{
  "name": "pi-extensions-oss",
  "version": "0.1.25",
  "description": "Productivity and resilience extensions for Pi: session notes scratchpad, safe screenshot guard, branch-aware todos, and OSS version status",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "productivity",
    "terminal-ui",
    "session-notes",
    "notes",
    "screenshot",
    "todo",
    "todos",
    "tui",
    "developer-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thegalexc/pi-extensions-oss.git"
  },
  "homepage": "https://github.com/thegalexc/pi-extensions-oss",
  "bugs": {
    "url": "https://github.com/thegalexc/pi-extensions-oss/issues"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "public"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "basic-ftp": "5.3.0"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "^0.66.0",
    "@mariozechner/pi-coding-agent": "^0.66.0",
    "@mariozechner/pi-tui": "^0.66.0",
    "@sinclair/typebox": "^0.34.41",
    "@types/node": "^24.5.2",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
